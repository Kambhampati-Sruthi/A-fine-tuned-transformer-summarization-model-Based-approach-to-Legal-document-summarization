# Never commit a real .env. All values are optional; defaults run fully offline (extractive mode).
SUMMARIZER_MODE=extractive          # extractive | abstractive | hybrid
MODEL_NAME=allenai/led-base-16384
MODEL_PATH=                         # path to your fine-tuned checkpoint (overrides MODEL_NAME)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2   # "none" = TF-IDF fallback; falls back automatically if unavailable
RERANKER_MODEL=                     # optional cross-encoder
NLI_MODEL=                          # optional MNLI-style cross-encoder for the verifier
DATABASE_URL=sqlite:///./app.db
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=20
APP_API_KEY=                        # set to require X-API-Key (also namespaces documents per key)
RETENTION_DAYS=7
OCR_ENABLED=false                   # needs Tesseract installed
LLM_PROVIDER=none                   # none | openai_compatible
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
CORS_ORIGINS=http://localhost:5173
